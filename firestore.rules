rules_version = '2';

// ===============================================================
// CEDA Innovation Canvas OS — Cloud Firestore Security Rules
// Database: ceda
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Live Activity Feed (Real-time innovation telemetry)
    match /activity_feed/{activityId} {
      allow read, write: if true;
    }

    // 2. Real-Time System Notifications & Alerts
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // 3. User Presence & Online/Offline Telemetry
    match /user_presence/{presenceId} {
      allow read, write: if true;
    }

    // 4. Live Canvas Card Transitions
    match /canvas_moves/{moveId} {
      allow read, write: if true;
    }

    // 5. Collaborative Workspaces (Real-time synchronization)
    match /workspaces/{workspaceId} {
      allow read, write: if true;
    }

    // 6. Global Session Policy & Security Broadcasts
    match /system_control/{docId} {
      allow read, write: if true;
    }

    // 7. Real-Time Admin Alerts & SLA Monitoring
    match /admin_alerts/{alertId} {
      allow read, write: if true;
    }

    // 8. User Profiles Directory (Synced with PostgreSQL & Auth)
    match /users/{userDocId} {
      allow read, write: if true;
    }

    // 9. Real-Time Submissions Intake Stream
    match /realtime_submissions/{subId} {
      allow read, write: if true;
    }

    // 10. Clarification Chats between Evaluator and Submitter
    match /clarification_chats/{chatId} {
      allow read, write: if true;
      match /{subCollection=**} {
        allow read, write: if true;
      }
    }

    // 11. Persistent Evaluator Assignments
    match /assigned_ideas/{assignmentId} {
      allow read, write: if true;
    }

    // Default match for any additional workspace subcollections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
